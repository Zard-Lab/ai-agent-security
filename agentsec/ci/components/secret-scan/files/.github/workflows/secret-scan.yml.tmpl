name: Secret Scan (Gitleaks)

# Installed by `agentsec ci add secret-scan`. No secrets or project-specific
# values are embedded. Allowlist intentionally-committed secrets in .gitleaks.toml.
on:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  gitleaks-secret-scan:
    name: Secret Scan (Gitleaks)
    runs-on: @@RUNNER@@
    # Non-blocking during rollout. After the first clean report, make this
    # blocking: remove `continue-on-error` and the `--exit-code 0` below.
    continue-on-error: true
    outputs:
      count: ${{ steps.scan.outputs.count }}
    steps:
    - name: Checkout full history
      uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2
      with:
        fetch-depth: 0

    - name: Ensure Gitleaks is installed (pinned)
      env:
        GITLEAKS_VERSION: "@@GITLEAKS_VERSION@@"
        # sha256 of gitleaks_${VERSION}_linux_x64.tar.gz from the release's
        # checksums.txt. Bump VERSION + SHA256 together from
        # https://github.com/gitleaks/gitleaks/releases.
        GITLEAKS_SHA256: "@@GITLEAKS_SHA256@@"
      run: |
        if ! command -v gitleaks >/dev/null; then
          echo "::warning::gitleaks not installed on runner — installing v${GITLEAKS_VERSION}"
          curl -fsSL -o /tmp/gitleaks.tar.gz \
            "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
          if [ -n "${GITLEAKS_SHA256}" ]; then
            echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz" | sha256sum -c -
          fi
          tar -xzf /tmp/gitleaks.tar.gz -C /tmp gitleaks
          sudo install /tmp/gitleaks /usr/local/bin/gitleaks
          rm -f /tmp/gitleaks.tar.gz /tmp/gitleaks
        fi
        gitleaks version

    - name: Scan full git history (allowlist via .gitleaks.toml)
      id: scan
      run: |
        # --exit-code 0 keeps this non-blocking during rollout. Drop it (and
        # continue-on-error above) once the first report is clean.
        gitleaks detect --source . --config .gitleaks.toml \
          --redact --report-format json --report-path gitleaks-report.json \
          --exit-code 0 --no-banner
        COUNT=$(jq 'length' gitleaks-report.json 2>/dev/null || echo 0)
        echo "Gitleaks findings outside allowlist: ${COUNT}"
        echo "count=${COUNT}" >> "$GITHUB_OUTPUT"
        if [ "${COUNT}" -gt 0 ]; then
          echo "::warning::Gitleaks found ${COUNT} potential secret(s) — review the gitleaks-results artifact"
          jq -r '.[] | "\(.File):\(.StartLine) [\(.RuleID)]"' gitleaks-report.json | head -50
        fi

    - name: Upload gitleaks report
      uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7.0.1
      if: always()
      with:
        name: gitleaks-results
        path: gitleaks-report.json
        retention-days: 30
